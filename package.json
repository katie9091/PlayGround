{
  "name": "blocksmith-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Blocksmith Minecraft Bedrock add-on studio",
  "scripts": {
    "copy:web": "node scripts/copy-web-assets.mjs",
    "android:sync": "npm run copy:web && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:export": "npm run android:debug && node scripts/export-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
